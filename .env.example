# Copy to .env to change a value. The defaults match the likho-infra local stack.

LIKHO_ENV=development
LOG_LEVEL=INFO

GRPC_PORT=5030
HTTP_PORT=4030

DATABASE_URL=postgresql+asyncpg://likho_language:likho_language@localhost:5433/likho_language
NATS_URL=nats://localhost:4222

# Create or update the tables when the service starts.
MIGRATE_ON_START=true
# Seconds a running service may use a workspace's vocabulary before checking for a newer version.
VOCABULARY_TTL_SECONDS=2
